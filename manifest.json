{
  "schemaVersion": 1,
  "id": "daniel-marr.omafilee",
  "name": "OmaFilee",
  "version": "0.1.0",
  "author": "Daniel Marr",
  "license": "MIT",
  "description": "Fast file conversion from your bar. Drag a file onto the donut (or pick one), choose the output format, done. Images, documents, video, audio and more.",
  "kinds": [
    "bar-widget",
    "panel"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "Converter.qml"
  },
  "barWidget": {
    "displayName": "Filee converter",
    "description": "Open the file conversion donut",
    "category": "Utilities",
    "aliases": [
      "filee",
      "convert",
      "converter"
    ],
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
